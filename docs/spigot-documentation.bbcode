[SIZE=5][B][COLOR=#FFAA00]3. Configuration Architecture[/COLOR][/B][/SIZE]

[SIZE=4][B][COLOR=#55FFFF]config.yml - Engine, Scheduler, Database & Modes[/COLOR][/B][/SIZE]
[CODE=yaml]
engine:
  prefix: '&8[&6&lChatGames&8]'
  suppress-winning-chat: true
  require-participation-permission: false
  speed-leaderboard-enabled: true
  restricted-worlds:
    - 'disabled_world_example'

scheduler:
  enabled: true
  interval-seconds: 300
  minimum-online-players: 1
  include-vanished-players: false

database:
  driver: 'SQLITE' # SQLITE or MYSQL
  table-prefix: 'cg_'
[/CODE]

[SIZE=4][B][COLOR=#55FFFF]prizes.yml - Structured Prize Pools & Inventory Protection[/COLOR][/B][/SIZE]
When [FONT=Courier New]GIVE_ITEM[/FONT] is triggered, ChatGames automatically checks for free inventory slots and safely drops any overflow items at the winner's feet.
[CODE=yaml]
pools:
  common-pool:
    weight: 70.0
    min-online: 1
    required-permission: ''
    actions:
      - type: 'GIVE_ITEM'
        material: 'IRON_INGOT'
        amount: 5
        probability: 100.0
      - type: 'PLAYER_MESSAGE'
        value: '{prefix} &aYou earned &f5x Iron Ingots &afor winning the round!'
        probability: 100.0
[/CODE]

[HR][/HR]

[SIZE=5][B][COLOR=#FFAA00]4. PlaceholderAPI Placeholders[/COLOR][/B][/SIZE]

[TABLE]
[TR]
[TH]Placeholder[/TH]
[TH]Description[/TH]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_score%[/FONT][/TD]
[TD]Competitor's total score / wins.[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_fastest_time%[/FONT][/TD]
[TD]Competitor's fastest reaction record in seconds.[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_visibility%[/FONT][/TD]
[TD]Returns whether round announcements are visible (true/false).[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_sound%[/FONT][/TD]
[TD]Returns whether audio cues are enabled (true/false).[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_rank_score%[/FONT][/TD]
[TD]Competitor's score leaderboard rank.[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_rank_speed%[/FONT][/TD]
[TD]Competitor's reaction speed leaderboard rank.[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_active%[/FONT][/TD]
[TD]Returns true if a round is currently running.[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_current_game%[/FONT][/TD]
[TD]Identifier of the active category, or none.[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_leaderboard_player_1%[/FONT][/TD]
[TD]Player name at score rank #1 (supports 1-10).[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_leaderboard_score_1%[/FONT][/TD]
[TD]Score value at rank #1 (supports 1-10).[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_speed_player_1%[/FONT][/TD]
[TD]Player name at speed rank #1 (supports 1-10).[/TD]
[/TR]
[TR]
[TD][FONT=Courier New]%chatgames_speed_time_1%[/FONT][/TD]
[TD]Reaction time at speed rank #1 (supports 1-10).[/TD]
[/TR]
[/TABLE]

