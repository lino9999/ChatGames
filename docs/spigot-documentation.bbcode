[SIZE=5][B][COLOR=#FFAA00]5. Developer API[/COLOR][/B][/SIZE]

[CODE=java]
@EventHandler
public void onRoundBegin(RoundBeginEvent event) {
    ChallengeCategory category = event.getCategory();
    String objective = event.getObjectiveDescription();
}

@EventHandler
public void onRoundComplete(RoundCompleteEvent event) {
    if (event.hasWinners()) {
        PodiumRecord firstPlace = event.getPodium().get(0);
    }
}
[/CODE]

